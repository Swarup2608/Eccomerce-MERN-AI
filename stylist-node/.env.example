# Same database the shop uses. The stylist only reads from it.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=
PORT=4100

# Wardrobe + suggestions (signed-in shoppers). Must match backend/.env.
ACCESS_TOKEN_SECRET=
STOREFRONT_URL=http://localhost:3000
# Name of the shop's access cookie: "localhost-user-access-token" in development, "__Secure-ecommerce-user-access-token" in production.
STYLIST_ACCESS_COOKIE=localhost-user-access-token
