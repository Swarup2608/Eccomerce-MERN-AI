# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
# Defaults to 127.0.0.1 in development and 0.0.0.0 in production.
# HOST=127.0.0.1
PORT=4000

# MongoDB Atlas connection string (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ecommerce

# Redis Cloud connection string. Prefer rediss:// (TLS) when your plan supports it.
REDIS_URL=rediss://default:<password>@<host>:<port>

# Comma-separated browser origins allowed to call the API (exact origins, no trailing slash).
# Production origins must be https.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Number of reverse-proxy hops in front of the API (0 = none, 1 = one load balancer).
TRUST_PROXY=0

# debug | info | warn | error
LOG_LEVEL=info

# Global per-IP rate limit.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# JWT signing secrets for access tokens. Must be different, random and at least 32 chars. Generate each with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
ADMIN_ACCESS_TOKEN_SECRET=

# Only used by `npm run seed:admin -w backend` to create the first admin. Remove them after seeding.
# Password: 12-128 characters. Phone is optional, in international format (+919876543210).
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
