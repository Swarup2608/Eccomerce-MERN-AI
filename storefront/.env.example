# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser, so never put secrets in them.

# Public base URL of the backend API (origin only, no trailing slash). Must be https in production.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Origin of the stylist service (stylist-node). Must be https in production.
NEXT_PUBLIC_STYLIST_URL=http://localhost:4100
