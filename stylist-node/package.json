{
  "name": "stylist-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "embed": "tsx --env-file-if-exists=.env src/embed-cli.ts",
    "eval": "tsx --env-file-if-exists=.env src/eval-cli.ts",
    "eval:chat": "tsx --env-file-if-exists=.env src/eval-cli.ts --chat",
    "test": "node --import tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
