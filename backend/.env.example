NODE_ENV=development

PORT=5000

MONGO_URI=mongodb://localhost:27017/eccomerce-mern-ai
# Used only by `npm test`. The database name must contain "Testing"; tests wipe it.
MONGO_TEST_URI=mongodb://localhost:27017/eccomerce-mern-ai-Testing
REDIS_URL=redis://localhost:6379

# At least 32 characters each, and different from each other. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated: storefront, admin, vendor
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

COOKIE_SECURE=false

# SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
VENDOR_URL=http://localhost:3002

# The Super Admin is a MongoDB user, not an env setting. Create it with:
# npm run seed:super-admin

# 64 hex chars; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Encrypts vendor bank account numbers.
DATA_ENCRYPTION_KEY=

# Cloudinary (signed uploads for vendor documents and product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Marketplace rules
CURRENCY=INR
PLATFORM_COMMISSION_PERCENT=10
FREE_SHIPPING_THRESHOLD=999
SHIPPING_FEE=49
RETURN_WINDOW_DAYS=7
PAYMENT_RESERVATION_MINUTES=30