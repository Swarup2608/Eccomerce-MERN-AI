{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"src/tests/**/*.test.ts\"",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "reset:admin": "tsx src/scripts/reset-admin.ts",
    "unblock:user": "tsx src/scripts/unblock-user.ts",
    "seed:catalog": "tsx src/scripts/seed-catalog.ts",
    "cleanup:uploads": "tsx src/scripts/cleanup-uploads.ts",
    "r2:cors": "tsx src/scripts/setup-r2-cors.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "nodemailer": "^10.0.16",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  }
}
