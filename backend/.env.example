# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
# Defaults to 127.0.0.1 in development and 0.0.0.0 in production.
# HOST=127.0.0.1
PORT=4000

# MongoDB Atlas connection string (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ecommerce

# Redis Cloud connection string. Prefer rediss:// (TLS) when your plan supports it.
REDIS_URL=rediss://default:<password>@<host>:<port>

# The two browser origins allowed to call the API (exact origins, no trailing slash). Production origins must be https.
# The storefront origin is also used in emailed links (verify email, reset password).
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Number of reverse-proxy hops in front of the API (0 = none, 1 = one load balancer). REQUIRED in production:
# too low and every user shares one rate-limit bucket, too high and clients can spoof their IP.
TRUST_PROXY=0

# Public origin of this API. Optional, but lets startup warn if the frontends are not on the same site
# (auth cookies are SameSite=Strict, so api.example.com + shop.example.com works, *.vercel.app + *.onrender.com does not).
# API_PUBLIC_URL=https://api.example.com

# Shares the shopper access cookie with sibling subdomains so the AI stylist (e.g. stylist.example.com) receives it.
# Must be the API host or a parent of it. Leave unset to keep the cookie on the API host only. Admin cookies never use it.
# COOKIE_DOMAIN=example.com

# Outgoing email (SMTP_HOST and EMAIL_FROM required in production). Without SMTP_HOST in development, emails are printed to the API log.
# Gmail: enable 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# (your normal password will not work). Paste the 16 characters without spaces. EMAIL_FROM must use the same address.
# Other providers: Outlook smtp.office365.com:587, Zoho smtp.zoho.com:465 (SMTP_SECURE=true).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false   # true for port 465
# SMTP_USER=youraddress@gmail.com   # or SMTP_EMAIL=... (same thing)
# SMTP_PASS=your16charapppassword
# EMAIL_FROM=Storefront <youraddress@gmail.com>

# Admin hardening: every admin sign-in emails a one-time code, so SMTP must work for the admin to log in.
# Optional comma-separated exact IPs allowed to reach /api/v1/admin/* (leave empty to allow any).
ADMIN_ALLOWED_IPS=

# debug | info | warn | error
LOG_LEVEL=info

# Global per-IP rate limit.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# JWT signing secrets for access tokens. Must be different, random and at least 32 chars. Generate each with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
ADMIN_ACCESS_TOKEN_SECRET=

# Only for `npm run seed:admin -w backend`. Prefer passing them inline for the one-off run instead of keeping them in a file:
#   SEED_ADMIN_EMAIL=... SEED_ADMIN_PASSWORD=... npm run seed:admin -w backend
# Password: 12-128 characters with upper, lower, number and special character.
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=

# ---- Product images: Cloudflare R2 (all five together, or none to disable uploads) ----
# R2 > Manage API tokens: create a token with "Object Read & Write" on this bucket only.
# R2_PUBLIC_URL is the bucket's public origin (a custom domain like https://images.example.com, or the r2.dev URL).
# The bucket needs a CORS rule so the admin browser can upload directly:
#   [{ "AllowedOrigins": ["<ADMIN_URL>"], "AllowedMethods": ["PUT"], "AllowedHeaders": ["content-type"], "MaxAgeSeconds": 3600 }]
# Abandoned uploads are removed by `npm run cleanup:uploads -w backend` (run it daily).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://images.example.com

# ---- Payments (each gateway is enabled when all of its values are set; Cash on Delivery is always available) ----
# Razorpay Dashboard > Account & Settings > API keys, and Webhooks (URL: <API>/api/v1/webhooks/razorpay,
# events: payment.captured, payment.failed, refund.processed).
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Stripe Dashboard > Developers > API keys, and Webhooks (URL: <API>/api/v1/webhooks/stripe, events:
# checkout.session.completed, checkout.session.expired, charge.refunded). Locally: `stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe`.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
