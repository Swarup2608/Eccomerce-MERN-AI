# Same database the shop uses. The stylist only reads from it.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=
PORT=4100

# Wardrobe + suggestions (signed-in shoppers). Must match backend/.env.
ACCESS_TOKEN_SECRET=
STOREFRONT_URL=http://localhost:3000

# Local AI (free). Install Ollama, then: ollama pull qwen3:4b-instruct && ollama pull nomic-embed-text && npm run embed
OLLAMA_URL=http://localhost:11434
STYLIST_CHAT_MODEL=qwen3:4b-instruct
STYLIST_EMBED_MODEL=nomic-embed-text
STYLIST_LLM_TIMEOUT_MS=20000
# Embed new or edited products every N minutes (0 = off; npm run embed does it by hand).
STYLIST_REINDEX_MINUTES=15
# Name of the shop's access cookie: "localhost-user-access-token" in development, "__Secure-ecommerce-user-access-token" in production.
STYLIST_ACCESS_COOKIE=localhost-user-access-token
